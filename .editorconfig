# Editor nào cũng đọc (VS Code cần extension "EditorConfig", JetBrains có sẵn).
# Khớp với .gitattributes: file mới tạo trên Windows cũng ra LF ngay từ đầu.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Xem .gitattributes: giữ nguyên CRLF tới khi Brain PR #3 merge.
[frontend/src/server/brain.ts]
end_of_line = unset
